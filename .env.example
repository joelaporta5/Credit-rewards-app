# Copy to .env for local development:  copy .env.example .env   (Windows)
# Generate the four secrets with:       python scripts/generate_keys.py

APP_ENV=development
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/rewards_dev
PUBLIC_BASE_URL=http://localhost:8000
TIMEZONE=America/New_York

ADMIN_API_KEY=
WALLET_API_KEY=
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# Plaid: start with Sandbox. Keys are at dashboard.plaid.com -> Developers -> Keys.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Optional, for OAuth banks on phones. Must be listed in the Plaid Dashboard (Developers -> API -> Allowed redirect URIs).
PLAID_REDIRECT_URI=

SCHEDULER_ENABLED=true
FALLBACK_SYNC_HOURS=6
